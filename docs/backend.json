{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the LocalLooms platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string",
          "description": "User's phone number."
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "location": {
          "type": "string",
          "description": "User's current location, could be city, or address."
        }
      },
      "required": [
        "id",
        "email",
        "displayName"
      ]
    },
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents an event posted on the LocalLooms platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event."
        },
        "title": {
          "type": "string",
          "description": "Title of the event."
        },
        "description": {
          "type": "string",
          "description": "Description of the event."
        },
        "locationName": {
          "type": "string",
          "description": "Name of the event location."
        },
        "latitude": {
          "type": "number",
          "description": "Latitude of the event location."
        },
        "longitude": {
          "type": "number",
          "description": "Longitude of the event location."
        },
        "date": {
          "type": "string",
          "description": "Start date and time of the event.",
          "format": "date-time"
        },
        "durationDays": {
          "type": "number",
          "description": "Duration of the event in days (up to 30)."
        },
        "category": {
          "type": "string",
          "description": "Category of the event."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the event image.",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the event was created.",
          "format": "date-time"
        },
        "organizer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The UID of the user who created the event."
            },
            "name": {
              "type": "string",
              "description": "The display name of the organizer."
            },
            "avatarUrl": {
              "type": "string",
              "description": "URL of the organizer's avatar."
            }
          },
          "required": ["id", "name"]
        },
        "status": {
            "type": "string",
            "enum": ["published", "draft", "pending", "denied"],
            "description": "The current status of the event."
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "A list of tags associated with the event."
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "latitude",
        "longitude",
        "date",
        "durationDays",
        "category",
        "createdAt",
        "organizer",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. The 'userId' parameter identifies the user.",
          "params": [
            {
              "name": "userId",
              "description": "Unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": {
            "$ref": "#/backend/entities/Event"
          },
          "description": "Central collection for all events.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            }
          ]
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Indicates admin privileges based on user ID. Existence of document grants admin role.",
          "params": [
            {
              "name": "userId",
              "description": "The ID of the user with admin privileges."
            }
          ]
        }
      }
    ],
    "reasoning": "This design uses a top-level 'events' collection for easier querying of public data, while maintaining a secure 'users' collection for private profiles. The 'roles_admin' collection provides a scalable way to manage admin privileges. Security rules enforce that users can only manage their own events, while admins have broader access. The 'organizer.id' field in each event is critical for enforcing ownership rules."
  }
}
