/**
 * LocalLooms Firestore Security Rules
 * Version: 2.4
 *
 * ## Core Philosophy
 * This ruleset enforces a strict security model based on user ownership and role-based access control.
 * The primary goal is to ensure that users can only manage their own data, while a
 * designated group of administrators has elevated privileges. Publicly viewable data is explicitly
 * marked as 'published' and filtered on the client-side.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isEventOwner(event) {
        return isOwner(event.organizer.id);
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }
    
    match /events/{eventId} {
        // LIST: Allow anyone to list events. Client-side queries are responsible
        // for filtering to only show 'published' events to the public. This is secure
        // because the 'get' rule below still protects individual documents.
        allow list: if true;

        // GET: Allow reading a single document if it's published, or if the user is the owner, or if the user is an admin.
        allow get: if (
            (resource.data.status == 'published') ||
            (isSignedIn() && (isEventOwner(resource.data) || isAdmin()))
        );

        // WRITE: Users can create, and can update/delete their own events.
        // Admins can update/delete any event.
        allow write: if isSignedIn() && (
          (request.method == 'create' && isOwner(request.resource.data.organizer.id)) ||
          ((request.method == 'update' || request.method == 'delete') && (isEventOwner(resource.data) || isAdmin()))
        );
    }

    match /roles_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Must be managed via backend/console
    }
  }
}
