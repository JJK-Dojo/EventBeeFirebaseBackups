/**
 * LocalLooms Firestore Security Rules
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. All user-generated content,
 * such as profiles and events, is stored in a data tree directly associated with
 * the user's unique ID (UID). This ensures that users can only access and modify
 * their own data, providing strong data isolation and privacy by default.
 *
 * Data Structure:
 * Data is organized hierarchically under the `/users/{userId}` path. A user's
 * profile is stored in the `/users/{userId}` document, and their created events
 * are stored in the `/users/{userId}/events` subcollection. This structure
 * makes ownership-based security rules simple and performant.
 *
 * Key Security Decisions:
 * - User Enumeration is Disallowed: Listing the top-level `/users` collection is
 *   explicitly forbidden to protect user privacy and prevent data scraping.
 * - Strict Ownership: All readable and writable data requires the requesting
 *   user's UID to match the `userId` in the document path. There is no public
 *   or shared data.
 * - Relational Integrity: On creation, documents must contain an internal ID
 *   field (`id` for Users, `userId` for Events) that matches the owning user's
 *   UID from the path. This field is enforced as immutable on updates, creating
 *   a permanent and trustworthy link to the owner.
 *
 * Denormalization for Authorization:
 * Each `Event` document contains a `userId` field. This denormalization is
 * crucial, as it allows security rules to verify ownership directly from the
 * document's data without needing extra database reads, ensuring fast and
 * cost-effective authorization checks.
 *
 * Structural Segregation:
 * The app's data is naturally segregated by user. By placing each user's events
 * in a dedicated subcollection (`/users/{userId}/events`), we leverage Firestore's
 * structure to guarantee that a query for events can only ever operate within the
 * security context of a single user's data tree.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the document's owner ID from the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the document being written to already exists.
     * Crucial for protecting against unintended updates or deletes on non-existent paths.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Combines owner and existence checks for secure update/delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }
    
    /**
     * On create, validates that the user document's internal 'id' field matches the path.
     */
    function createdWithMatchingId(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * On update, ensures the user document's internal 'id' field is immutable.
     */
    function idIsImmutable() {
      return request.resource.data.id == resource.data.id;
    }
    
    /**
     * On create, validates that the event document's internal 'userId' field matches the path.
     */
    function createdWithMatchingUserId(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * On update, ensures the event document's internal 'userId' field is immutable.
     */
    function userIdIsImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }


    // --------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------

    /**
     * @description Secures a user's own profile document.
     * @path /users/{userId}
     * @allow (get) A signed-in user ('user_abc') reading their own profile at `/users/user_abc`.
     * @allow (create) A new user ('user_abc') creating their own profile document at `/users/user_abc`.
     * @deny (list) Any user attempting to list all documents in the `/users` collection.
     * @deny (get) User 'user_123' trying to read the profile of 'user_abc'.
     * @principle Restricts access to a user's own private data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && createdWithMatchingId(userId);
      allow update: if isExistingOwner(userId) && idIsImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures the events created by a specific user.
     * @path /users/{userId}/events/{eventId}
     * @allow (create) User 'user_abc' creating a new event in their own subcollection at `/users/user_abc/events/event_123`.
     * @allow (list) User 'user_abc' listing all events within their own subcollection at `/users/user_abc/events`.
     * @deny (update) User 'user_123' attempting to modify an event owned by 'user_abc'.
     * @deny (create) User 'user_abc' trying to create an event with a mismatched `userId` field in the data.
     * @principle Enforces document ownership and validates relational integrity between the event and its owner.
     */
    match /users/{userId}/events/{eventId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && createdWithMatchingUserId(userId);
      allow update: if isExistingOwner(userId) && userIdIsImmutable();
      allow delete: if isExistingOwner(userId);
    }
  }
}