/**
 * LocalLooms Firestore Security Rules
 * Version: 2.0
 *
 * ## Core Philosophy
 * This ruleset enforces a strict security model based on user ownership and role-based access control.
 * The primary goal is to ensure that users can only manage their own data, while a
 * designated group of administrators has elevated privileges. Publicly viewable data is explicitly
 * marked as 'published'.
 *
 * ## Data Structure
 * - `/users/{userId}`: Stores private user profile data, accessible only by the owning user.
 * - `/events/{eventId}`: A top-level collection for all events. This allows for easier querying
 *   of public events across all users.
 * - `/roles_admin/{userId}`: A lookup collection where the existence of a document signifies
 *   that the user is an administrator.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isEventOwner(event) {
        return isOwner(event.organizer.id);
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }
    
    match /events/{eventId} {
        // Anyone can read a published event
        allow get: if resource.data.status == 'published' || isEventOwner(resource.data) || isAdmin();
        
        // Anyone can list published events
        allow list: if true;
        
        // Users can create new events
        allow create: if isOwner(request.resource.data.organizer.id);

        // Users can update their own events, admins can update any
        allow update: if isEventOwner(resource.data) || isAdmin();

        // Users can delete their own events, admins can delete any
        allow delete: if isEventOwner(resource.data) || isAdmin();
    }

    match /roles_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Must be managed via backend/console
    }
  }
}
