
/**
 * Eventide Firestore Security Rules
 *
 * Core Philosophy:
 * This ruleset uses a dual-collection approach. The `/users` collection enforces
 * a strict user-ownership model for private profile data. The `/events` collection
 * provides a public space for event documents, allowing them to be listed by any
 * authenticated user, while still restricting write access to the event's creator.
 *
 * Data Structure & Key Decisions:
 * - User Data: `/users/{userId}` is strictly private. Only the owner can read or
 *   write their own profile. Listing the `/users` collection is forbidden to
 *   prevent user enumeration and protect privacy.
 * - Event Data: `/events/{eventId}` is the central, public collection for all
 *   event listings.
 *   - Read Access (`get`, `list`): Any user (authenticated or not) can read events,
 *     which is essential for public-facing pages like the landing page and event discovery.
 *   - Write Access (`create`, `update`, `delete`): Only the user whose UID matches
 *     the `userId` field inside the event document can modify it. This enforces
 *     ownership at the document level.
 *
 * Denormalization for Authorization:
 * Each `Event` document contains a `userId` field. This denormalization is
 * crucial, as it allows security rules to verify ownership directly from the
 * document's data (`resource.data.userId`) without needing extra database reads,
 * ensuring fast and cost-effective authorization checks for all write operations.
 *
 * Relational Integrity:
 * On document creation, the `id` and `userId` fields within the data must match
 * the document's ID and the authenticated user's UID, respectively. These fields
 * are enforced as immutable on updates, creating a permanent and trustworthy link
 * between the document, its ID, and its owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the document's owner ID from the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * Checks if the document being written to already exists.
     * Crucial for protecting against unintended updates or deletes on non-existent paths.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Combines owner and existence checks for secure update/delete operations on path-based ownership.
     */
    function isExistingPathOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }
    
     /**
     * Combines owner and existence checks for secure update/delete operations on resource-based ownership.
     */
    function isExistingResourceOwner() {
      return isSignedIn() && isExistingDoc() && request.auth.uid == resource.data.userId;
    }
    
    /**
     * On create, validates that the user document's internal 'id' field matches the path.
     */
    function createdWithMatchingId(userId) {
      return request.resource.data.id == userId;
    }
    
    /**
     * On create, validates that the event document's internal 'userId' field matches the authenticated user.
     */
    function createdWithMatchingUserId() {
      return request.resource.data.userId == request.auth.uid;
    }
    
     /**
     * On create, validates that the event document's 'id' field matches its actual document ID.
     */
    function eventIdMatchesDocId(eventId) {
        return request.resource.data.id == eventId;
    }
    
    /**
     * Checks if the currently authenticated user has an 'admin' role.
     * This requires reading the user's own profile document.
     */
    function isUserAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }


    // --------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------

    /**
     * @description Secures a user's own profile document.
     * @path /users/{userId}
     * @allow (get) A signed-in user ('user_abc') reading their own profile at `/users/user_abc`.
     * @allow (list) An admin user listing all documents in the `/users` collection.
     * @allow (create) A new user ('user_abc') creating their own profile document at `/users/user_abc`.
     * @deny (list) Any non-admin user attempting to list all documents in the `/users` collection.
     * @deny (get) User 'user_123' trying to read the profile of 'user_abc' unless 'user_123' is an admin.
     * @principle Restricts access to a user's own private data tree and prevents user enumeration, except for admins.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isUserAdmin();
      allow list: if isUserAdmin();
      allow create: if isOwner(userId) && createdWithMatchingId(userId);
      allow update: if isExistingDoc() && (
        isUserAdmin() ||
        (isOwner(userId) &&
          !('id' in request.resource.data) &&
          !('uid' in request.resource.data) &&
          !('role' in request.resource.data)
        )
      );
      allow delete: if isExistingPathOwner(userId) || isUserAdmin();
    }
    
    /**
     * @description Secures the public collection of all events.
     * @path /events/{eventId}
     * @allow (list, get) Any authenticated user can read event data for discovery.
     * @allow (create) A user can create an event if the `userId` in the new document matches their own UID.
     * @allow (update, delete) A user can modify or delete an event only if the `userId` in the *existing* document matches their UID.
     * @deny (update) A user trying to change the `userId` of an event after it has been created.
     * @principle Enables public discovery of events while strictly enforcing ownership for all write operations.
     */
    match /events/{eventId} {
      allow list, get;
      allow create: if isSignedIn() && createdWithMatchingUserId() && eventIdMatchesDocId(eventId);
      allow update: if isUserAdmin() || (
        isSignedIn() &&
        isExistingDoc() &&
        // On any update, ensure 'id' and 'userId' are not being changed by a non-admin.
        request.resource.data.id == resource.data.id &&
        request.resource.data.userId == resource.data.userId &&
        request.auth.uid == resource.data.userId
      );
      allow delete: if isExistingResourceOwner() || isUserAdmin();
    }
  }
}
