
/**
 * This ruleset enforces a strict user-ownership security model for the LocalLooms application.
 *
 * Core Philosophy:
 * All user-generated content is stored within a data silo specific to that user. Access is
 * granted based on the user's authenticated UID matching the corresponding segment in the
 * document path. This path-based ownership model is simple, secure, and performant.
 *
 * Data Structure:
 * - /users/{userId}: Stores the public profile for a user.
 * - /events/{eventId}: A top-level collection for all events.
 *
 * Key Security Decisions:
 * - Strict Ownership for User Profiles: Users have full control over their own profile. They cannot
 *   access, view, or modify any data belonging to other users.
 * - Public Read on Events: All users (authenticated or not) can read from the top-level `/events`
 *   collection. This is necessary for pages like "Find Events" and "DB View".
 * - Authenticated Write on Events: Only authenticated users can create, update, or delete events.
 *   Ownership is enforced by checking a `userId` field within the event document.
 * - No Public User Listing: Listing all users from the top-level `/users` collection is explicitly
 *   disallowed to protect user privacy and prevent data scraping.
 * - Path-Based Authorization: For user profiles, authorization decisions are made by inspecting the document
 *   path and comparing it against the authenticated user's ID.
 * - Field-Based Authorization: For events, authorization is based on the `userId` field inside the document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------------
    // /users Collection Rules
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // ------------------------------------------------------------------------
    // /events Collection Rules
    // ------------------------------------------------------------------------
    match /events/{eventId} {
      // Anyone can read events
      allow get, list: if true;
      
      // Only signed-in users can create events, and they must be the owner
      allow create: if isSignedIn() && request.resource.data.organizer.id == request.auth.uid;
      
      // Only the event owner can update or delete their event
      allow update, delete: if isSignedIn() && resource.data.organizer.id == request.auth.uid;
    }
  }
}
